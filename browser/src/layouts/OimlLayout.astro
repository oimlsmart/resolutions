---
/**
 * The resolutions site's layout — wraps @oimlsmart/site-shell's Base
 * (the federation chrome, TODO.fix/08). The layout keeps what is local
 * and bilingual: the lang prop down to the html element, the
 * locale-prefixed minisite sections, and the EN/FR language toggle in
 * the MinisiteNav's right slot. The committee text lives on the about
 * page (it was duplicated in the old footer); external OIML links stay
 * in page content.
 */
import cfg from 'virtual:edoxen-config'
import { Base as ShellBase, MinisiteNav } from '@oimlsmart/site-shell'
import { urlPrefix, localePrefixOf } from '../utils/url.js'
import { t } from '../utils/i18n.js'
import '../styles/app.css'

interface Props {
  lang?: string
  title?: string
}
const { lang = cfg.site.locale, title } = Astro.props
const enPrefix = urlPrefix(cfg.site.basePath, localePrefixOf(cfg.locales, 'en'))
const frPrefix = urlPrefix(cfg.site.basePath, localePrefixOf(cfg.locales, 'fr'))
const prefix = lang === 'fr' ? frPrefix : enPrefix
const pageTitle = title ? `${title} | ${cfg.site.title}` : cfg.site.title

const basePath = cfg.site.basePath
const currentPath = Astro.url.pathname.replace(new RegExp(`^${basePath.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`), '/')
const swapLang = (target: string) => {
  const currentLang = lang
  if (currentLang === target) {
    return `${basePath}${currentPath.replace(/^\//, '')}`.replace(/\/{2,}/g, '/')
  }
  const other = currentLang === 'en' ? 'fr' : 'en'
  const currentSeg = localePrefixOf(cfg.locales, currentLang)
  const otherSeg = localePrefixOf(cfg.locales, other)
  if (currentSeg && currentPath.startsWith(`${currentSeg}/`)) {
    return `${basePath}${otherSeg}${currentPath.slice(currentSeg.length)}`.replace(/\/{2,}/g, '/')
  }
  return `${basePath}${otherSeg}/`.replace(/\/{2,}/g, '/')
}

const SECTIONS = [
  { label: t(lang, 'nav.resolutions'), href: prefix },
  { label: t(lang, 'nav.meetings'), href: `${prefix}meetings` },
  { label: t(lang, 'nav.about'), href: `${prefix}about` },
]
---

<ShellBase title={pageTitle} lang={lang}>
  <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} slot="head" />
  <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: light)" href={`${basePath}assets/oiml-logo-icon-light.svg`} slot="head" />
  <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: dark)" href={`${basePath}assets/oiml-logo-icon-dark.svg`} slot="head" />
  <link rel="apple-touch-icon" href={`${basePath}assets/oiml-logo-icon-light.svg`} slot="head" />
  <link rel="manifest" href={`${basePath}site.webmanifest`} slot="head" />

  <MinisiteNav sections={SECTIONS}>
    <div class="lang-toggle inline-flex items-center border border-rule rounded-full p-0.5" role="group" aria-label={t(lang, 'lang.toggle')}>
      <a href={swapLang('en')} class={`lang-toggle__btn px-2.5 py-1 text-xs font-semibold rounded-full no-underline transition-colors ${lang === 'en' ? 'bg-accent text-white' : 'text-ink-soft hover:bg-paper-raised'}`}>EN</a>
      <a href={swapLang('fr')} class={`lang-toggle__btn px-2.5 py-1 text-xs font-semibold rounded-full no-underline transition-colors ${lang === 'fr' ? 'bg-accent text-white' : 'text-ink-soft hover:bg-paper-raised'}`}>FR</a>
    </div>
  </MinisiteNav>

  <slot />
</ShellBase>
